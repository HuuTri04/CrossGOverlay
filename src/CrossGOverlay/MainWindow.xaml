<Window x:Class="CrossGOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrossGOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid IsHitTestVisible="False">
        <Canvas Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Line X1="0" Y1="24" X2="18" Y2="24" Stroke="Lime" StrokeThickness="2"/>
            <Line X1="30" Y1="24" X2="48" Y2="24" Stroke="Lime" StrokeThickness="2"/>
            <Line X1="24" Y1="0" X2="24" Y2="18" Stroke="Lime" StrokeThickness="2"/>
            <Line X1="24" Y1="30" X2="24" Y2="48" Stroke="Lime" StrokeThickness="2"/>
            <Ellipse Width="6" Height="6" Canvas.Left="21" Canvas.Top="21" Stroke="Lime" StrokeThickness="2"/>
        </Canvas>
    </Grid>
</Window>
