<UserControl x:Class="CrosshairOverlay.Controls.SliderField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsTabStop="False">
    <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LabelColumnWidth, ElementName=Root}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="{Binding Label, ElementName=Root, Mode=OneWay}"
                   Background="Transparent" Cursor="Hand"
                   PreviewMouseDown="OnLabelPreviewMouseDown"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Label, ElementName=Root, Mode=OneWay}"/>

        <Slider x:Name="TrackSlider" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0"
                Focusable="True" IsTabStop="True" PreviewMouseDown="OnSliderPreviewMouseDown"
                PreviewKeyDown="OnSliderPreviewKeyDown"
                Minimum="{Binding Minimum, ElementName=Root, Mode=OneWay}"
                Maximum="{Binding Maximum, ElementName=Root, Mode=OneWay}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=15}"/>

        <!--
            Ô nhập số. Bind vào Text chứ không bind thẳng vào Value — bind số kèm định dạng sẽ
            liên tục viết đè lên thứ người dùng đang gõ và nhảy con trỏ.

            UpdateSourceTrigger=PropertyChanged kết hợp Delay=300: chữ hiện ra trong ô ngay lập
            tức (Delay chỉ hoãn chiều đẩy về nguồn), nhưng preview chỉ vẽ lại sau khi người dùng
            ngừng gõ 300ms. Không có Delay thì gõ "35" sẽ vẽ lại một lần ở "3" — một crosshair
            bé xíu nhấp nháy giữa chừng — rồi mới tới "35".
        -->
        <TextBox x:Name="Box" Grid.Column="2" Style="{StaticResource NumericBox}"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged, Delay=300}"
                 LostFocus="OnBoxLostFocus"
                 PreviewKeyDown="OnBoxKeyDown"/>
    </Grid>
</UserControl>
