<UserControl x:Class="CrosshairOverlay.Views.StatsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CrosshairOverlay.Localization">
    <ScrollViewer Style="{StaticResource PanelScrollViewer}">
        <StackPanel Margin="0,0,4,12">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Stats_Session}" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc Stats_VisibleTime}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding VisibleTime}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc Stats_Switches}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SwitchCount}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Stats_ActivePreset}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding ActivePreset}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivePreset}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Stats_Timeline}" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RangeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedRange, Mode=TwoWay}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DailyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                 Value="{Binding PercentOfMax}" Height="10" Margin="8,3"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="11.5"
                                               TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Stats_Usage}" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                 Value="{Binding Percent}" Height="9" Margin="8,4"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" TextAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Stats_Cleanup}" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc Stats_DataSize}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FileSizeText}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Content="{loc:Loc Stats_AutoCleanup}" Margin="0,0,0,12"
                              IsChecked="{Binding AutoCleanupOldData, Mode=TwoWay}"/>
                    <Button Content="{loc:Loc Stats_Clear}" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Command="{Binding ClearStatsCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
