<UserControl x:Class="CrosshairOverlay.Views.PixelArtTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CrosshairOverlay.Controls"
             xmlns:loc="clr-namespace:CrosshairOverlay.Localization"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <SolidColorBrush x:Key="PixelGreen" Color="#00FF00" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelRed" Color="#FF0000" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelWhite" Color="#FFFFFF" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelYellow" Color="#FFFF00" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelBlue" Color="#00BFFF" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelMagenta" Color="#FF00FF" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelOrange" Color="#FF8800" po:Freeze="True"/>
        <SolidColorBrush x:Key="PixelBlack" Color="#000000" po:Freeze="True"/>

        <Style x:Key="PixelSwatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="ctl:SmoothScrollBehavior.IsScrolling" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PanelScrollViewer}">
        <Grid Margin="0,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Pixel_Tools}" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Pixel_GridSize}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" MaxLength="4"
                                     Text="{Binding GridSizeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnGridSizePreviewKeyDown"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="{loc:Loc Pixel_ApplySize}"
                                    Command="{Binding ApplyGridSizeCommand}" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{loc:Loc Pixel_GridHint}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                            <TextBlock Text="{loc:Loc Pixel_InputDevice}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton GroupName="PixelDrawingInput" Style="{StaticResource FilterChip}"
                                         Command="{Binding UseMouseInputCommand}"
                                         IsChecked="{Binding IsMouseInputSelected, Mode=OneWay}"
                                         AutomationProperties.Name="{loc:Loc Pixel_InputMouse}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 9,1 C 5,1 3,4 3,8 L 3,13 C 3,17 5,20 9,20 C 13,20 15,17 15,13 L 15,8 C 15,4 13,1 9,1 Z M 9,2 L 9,8"
                                          Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5"
                                          Width="18" Height="20" Stretch="Uniform"/>
                                    <TextBlock Text="{loc:Loc Pixel_InputMouse}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="PixelDrawingInput" Style="{StaticResource FilterChip}"
                                         Command="{Binding UseStylusInputCommand}"
                                         IsChecked="{Binding IsStylusInputSelected, Mode=OneWay}"
                                         AutomationProperties.Name="{loc:Loc Pixel_InputStylus}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 3,17 L 5,12 L 13,3 L 16,6 L 8,15 Z M 12,4 L 15,7"
                                          Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5"
                                          Width="18" Height="20" Stretch="Uniform"/>
                                    <TextBlock Text="{loc:Loc Pixel_InputStylus}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </DockPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{loc:Loc Pixel_Brush}" Command="{Binding UseBrushCommand}" Margin="0,0,8,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#2800ED64"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Loc Pixel_Eraser}" Command="{Binding UseEraserCommand}" Margin="0,0,8,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEraserSelected}" Value="True">
                                                <Setter Property="Background" Value="#2800ED64"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Loc Pixel_Clear}" Command="{Binding ClearCanvasCommand}" Margin="0,0,8,8"/>
                            <Button Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Loc Pixel_Undo}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 5,3 L 1,7 L 5,11 M 2,7 C 12,-1 20,7 17,15" Stroke="{StaticResource TextPrimary}"
                                          StrokeThickness="1.5" Width="18" Height="16" Stretch="None"/>
                                    <TextBlock Text="{loc:Loc Pixel_Undo}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RedoCommand}" ToolTip="Ctrl+Y / Ctrl+Shift+Z" Margin="0,0,8,8"
                                    AutomationProperties.Name="{loc:Loc Pixel_Redo}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 13,3 L 17,7 L 13,11 M 16,7 C 6,-1 -2,7 1,15" Stroke="{StaticResource TextPrimary}"
                                          StrokeThickness="1.5" Width="18" Height="16" Stretch="None"/>
                                    <TextBlock Text="{loc:Loc Pixel_Redo}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Content="{loc:Loc Pixel_CenterGuide}" Command="{Binding ToggleCenterGuideCommand}" Margin="0,0,0,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCenterGuide}" Value="True">
                                                <Setter Property="Background" Value="#2800ED64"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Pixel_Canvas}" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4"
                                Padding="8" HorizontalAlignment="Center">
                            <ScrollViewer x:Name="CanvasScrollViewer" Width="384" Height="384" CanContentScroll="False"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ctl:PixelArtCanvas x:Name="DrawingCanvas" Loaded="OnCanvasLoaded"
                                                    SizeChanged="OnCanvasSizeChanged"
                                                    Width="{Binding CanvasDisplaySize, Mode=OneWay}"
                                                    Height="{Binding CanvasDisplaySize, Mode=OneWay}"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Stylus.IsFlicksEnabled="False"
                                                    Stylus.IsPressAndHoldEnabled="False"
                                                    Stylus.IsTapFeedbackEnabled="False"
                                                    Stylus.IsTouchFeedbackEnabled="False"
                                                    Bitmap="{Binding Bitmap, Mode=OneWay}"
                                                    GridSize="{Binding GridSize, Mode=OneWay}"
                                                    ShowCenterGuide="{Binding ShowCenterGuide, Mode=OneWay}"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{loc:Loc Pixel_DrawHint}" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Center" MaxWidth="384" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Pixel_Palette}" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelGreen}" ToolTip="#00FF00"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#00FF00"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelRed}" ToolTip="#FF0000"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#FF0000"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelWhite}" ToolTip="#FFFFFF"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#FFFFFF"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelYellow}" ToolTip="#FFFF00"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#FFFF00"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelBlue}" ToolTip="#00BFFF"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#00BFFF"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelMagenta}" ToolTip="#FF00FF"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#FF00FF"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelOrange}" ToolTip="#FF8800"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#FF8800"/>
                            <Button Style="{StaticResource PixelSwatch}" Background="{StaticResource PixelBlack}" ToolTip="#000000"
                                    Command="{Binding SelectPaletteColorCommand}" CommandParameter="#000000"/>
                        </WrapPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding SelectedColorBrush, Mode=OneWay}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="4" Width="28" Height="28"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="7" VerticalContentAlignment="Center" Margin="4,0,8,0"/>
                            <Button Grid.Column="2" Content="{loc:Loc Pixel_CustomColor}"
                                    Command="{Binding SelectCustomColorCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Pixel_ShareTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBox x:Name="ShareCodeTextBox"
                                 Text="{Binding VisibleShareCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 GotKeyboardFocus="OnShareCodeFocused" LostKeyboardFocus="OnShareCodeLostFocus"
                                 Height="125" MaxLength="32768" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalAlignment="Top" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{Binding GeneratedCodeStatus, Mode=OneWay}"
                                   Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:Loc Pixel_CodeHint}" Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{loc:Loc Pixel_CopyCode}" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc Pixel_LoadCode}" Command="{Binding LoadCodeCommand}"
                                    CommandParameter="{Binding Text, ElementName=ShareCodeTextBox}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding CodeLoadMessage, Mode=OneWay}"
                                   Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Pixel_SaveTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="{loc:Loc Pixel_PresetName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                        <Button Content="{loc:Loc Pixel_SavePreset}" Command="{Binding SavePresetCommand}"
                                Style="{StaticResource AccentButton}" Margin="0,12,0,8"/>
                        <Button Content="{loc:Loc Pixel_ApplyDirect}" Command="{Binding ApplyDirectCommand}"/>
                        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap" Height="38" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
