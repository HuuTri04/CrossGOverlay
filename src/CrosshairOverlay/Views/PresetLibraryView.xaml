<UserControl x:Class="CrosshairOverlay.Views.PresetLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CrosshairOverlay.Localization"
             xmlns:ctl="clr-namespace:CrosshairOverlay.Controls"
             xmlns:vm="clr-namespace:CrosshairOverlay.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PresetLibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            Một thẻ mẫu. Không có binding hai chiều hay trigger nào: thẻ được tái dùng liên tục khi cuộn.
            KHÔNG đặt x:Key: ô của hàng tìm mẫu này theo kiểu dữ liệu, nên ô trống (null) không dựng gì. Gán
            ContentTemplate cứng thì WPF vẫn dựng thẻ cho ô null — ra những thẻ rỗng thừa ở cuối hàng.
        -->
        <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
            <Border Style="{StaticResource CatalogCard}" Margin="0,0,12,12">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ctl:CrosshairThumbnail Grid.Row="0" Profile="{Binding PreviewProfile}" Renderer="{Binding Renderer}"/>

                    <TextBlock Grid.Row="1" Margin="2,7,2,6" Text="{Binding Name}" ToolTip="{Binding Name}"
                               FontSize="12.5" TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Row="2" Style="{StaticResource SmallAccentButton}"
                            Content="{loc:Loc Library_Use}"
                            AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.HelpText="{loc:Loc Library_Use}"
                            Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== Thanh công cụ: ô tìm kiếm bên trái, chip danh mục bên phải -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="330"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     VerticalAlignment="Center"
                     Tag="{loc:Loc Library_SearchPlaceholder}"
                     AutomationProperties.Name="{loc:Loc Library_SearchPlaceholder}"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Số mẫu đang hiện: người dùng gõ tìm kiếm cần biết ngay còn bao nhiêu kết quả. -->
            <TextBlock Grid.Column="1" Text="{Binding ResultText}" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>

            <ItemsControl Grid.Column="2" ItemsSource="{Binding Categories}" Focusable="False"
                          Margin="16,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryChipViewModel}">
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="LibraryCategory"
                                     Margin="6,3,0,3"
                                     AutomationProperties.Name="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}"/>
                                <TextBlock Text="{Binding Count}" Margin="6,0,0,0" Opacity="0.65"/>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--
            ======== Lưới thẻ, ảo hoá hoàn toàn. Mỗi phần tử của Rows là MỘT HÀNG thẻ (xem PresetLibraryViewModel):
            chỉ các hàng đang nhìn thấy (cộng một trang đệm mỗi phía) mới có thẻ thật, và thẻ được tái dùng khi cuộn.
            CanContentScroll phải bật, nếu không ScrollViewer đo toàn bộ nội dung và ảo hoá mất tác dụng;
            ScrollUnit=Pixel giữ cuộn mượt từng pixel thay vì nhảy từng hàng.
        -->
        <ItemsControl x:Name="RowsList" Grid.Row="1"
                      ItemsSource="{Binding Rows}"
                      Focusable="False"
                      SizeChanged="OnRowsSizeChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLengthUnit="Page"
                      VirtualizingPanel.CacheLength="1,1"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False" CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CatalogRow}">
                    <!--
                        Ô cố định, KHÔNG dùng ItemsControl lồng: khi hàng được tái dùng, ContentPresenter giữ nguyên
                        cây giao diện của thẻ và chỉ đổi dữ liệu (xem CatalogRow). Ô không có mẫu thì rỗng, không vẽ gì.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Content="{Binding Slot0}"/>
                        <ContentPresenter Content="{Binding Slot1}"/>
                        <ContentPresenter Content="{Binding Slot2}"/>
                        <ContentPresenter Content="{Binding Slot3}"/>
                        <ContentPresenter Content="{Binding Slot4}"/>
                        <ContentPresenter Content="{Binding Slot5}"/>
                        <ContentPresenter Content="{Binding Slot6}"/>
                        <ContentPresenter Content="{Binding Slot7}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Đang đọc / không có kết quả -->
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Library_Loading}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420"
                   Style="{StaticResource FieldLabel}" Text="{Binding EmptyText}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Thông báo nhỏ ở góc dưới, tự ẩn sau 2,5 giây. Người dùng vẫn ở lại tab để chọn tiếp mẫu khác. -->
        <Border Grid.Row="1" Style="{StaticResource Toast}" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,18,18"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ToastText}" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
        </Border>
    </Grid>
</UserControl>
