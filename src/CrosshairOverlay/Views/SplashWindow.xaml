<Window x:Class="CrosshairOverlay.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CrosshairOverlay.Localization"
        Title="CrossGOverlay"
        Icon="pack://application:,,,/images/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Màn hình chờ lúc khởi động. Cùng nền với cửa sổ chính (WindowBg) để lúc cửa sổ Settings phủ lên
        rồi màn hình chờ đóng lại, mắt không thấy hai mảng màu khác nhau chớp qua.
        Không Effect (đổ bóng/làm mờ): viền 1px mờ là đủ tách khỏi nền desktop.
    -->
    <Border Width="300" Height="350" CornerRadius="8"
            Background="{StaticResource WindowBg}"
            BorderBrush="#1AFFFFFF" BorderThickness="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!--
                BrandingLogo.ico ĐỤC hoàn toàn (không có kênh alpha): ngoài khối logo bo góc là bốn góc màu
                xanh đậm, trên nền tối nhìn thành một ô vuông viền quanh logo. Cắt theo đúng hình khối logo:
                khối sáng chiếm trọn khung, bán kính bo ≈ 19% cạnh (đo trên ảnh gốc: 48/252 px) → 18/96.
                Stretch=Fill vì khung gốc 252x256 lệch 1,6% — không nhìn ra, đổi lại vết cắt khít đều bốn góc.
            -->
            <Image Width="96" Height="96" HorizontalAlignment="Center" Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Source>
                    <!-- Giải mã ngay ở cỡ hiển thị (x2 cho màn hình DPI cao) thay vì cả khung 252x256. -->
                    <BitmapImage UriSource="pack://application:,,,/images/BrandingLogo.ico" DecodePixelWidth="192"/>
                </Image.Source>
                <Image.Clip>
                    <RectangleGeometry Rect="0,0,96,96" RadiusX="18" RadiusY="18"/>
                </Image.Clip>
            </Image>

            <TextBlock Text="CrossGOverlay" HorizontalAlignment="Center" Margin="0,18,0,0"
                       FontFamily="{StaticResource UiFont}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>

            <TextBlock x:Name="StatusText" Text="{loc:Loc Splash_Starting}" HorizontalAlignment="Center"
                       Margin="0,10,0,0" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Opacity="0.5">
                <!--
                    Nhấp nháy mờ 0.5 ↔ 1. Chỉ sống trong khoảng một giây màn hình chờ hiện; cửa sổ đóng là
                    đồng hồ animation dừng theo. Luồng giao diện đang bận khởi động nên nhịp có thể không
                    đều — chấp nhận được cho một dòng chữ trạng thái.
                -->
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.5" To="1" Duration="0:0:0.8" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
