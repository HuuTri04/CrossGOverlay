<Window x:Class="CrosshairOverlay.Views.SystemTrayToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="400" SizeToContent="Height" Opacity="0">
    <Window.Resources>
        <Style x:Key="ToastGhostButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ToastCard" Width="384" MinHeight="100" Margin="8"
            Padding="16,14,16,16"
            Background="#202020" BorderBrush="#2C2C2C" BorderThickness="1"
            CornerRadius="8">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="10"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="16" Height="16" Stretch="Uniform"
                               Source="pack://application:,,,/Resources/icon.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="CrossGOverlay" FontSize="12" Foreground="#CCCCCC"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="•••" Style="{StaticResource ToastGhostButton}"
                                Click="OnMoreClicked" AutomationProperties.Name="More options"/>
                        <Button Content="✕" Style="{StaticResource ToastGhostButton}" Margin="2,0,0,0"
                                Click="OnCloseClicked" AutomationProperties.Name="Close notification"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,0,14,0">
                        <Image Width="40" Height="40" Stretch="Uniform"
                               Source="pack://application:,,,/Resources/icon.png"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BodyText" FontSize="12" Foreground="#CCCCCC"
                                   LineHeight="17" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </Border>
</Window>
