<Window x:Class="CrosshairOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CrosshairOverlay.Controls"
        xmlns:views="clr-namespace:CrosshairOverlay.Views"
        xmlns:loc="clr-namespace:CrosshairOverlay.Localization"
        xmlns:core="clr-namespace:CrosshairOverlay.Core"
        xmlns:lim="clr-namespace:CrosshairOverlay.Core.Models"
        Title="{x:Static core:AppInfo.DisplayName}"
        Icon="pack://application:,,,/images/app.ico"
        Width="1180" Height="760" MinWidth="960" MinHeight="620"
        Background="{StaticResource WindowBg}"
        ctl:WheelScrollAssist.IsEnabled="True"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!--
            Bộ điều khiển cho MỘT lớp nhánh. Nhánh trong và nhánh ngoài dùng chung template này,
            chỉ khác object được gán vào Content — nên hai nhóm không thể lệch nhau về bộ điều
            khiển, và thêm một thông số cho lớp nhánh chỉ phải sửa một chỗ.
        -->
        <DataTemplate x:Key="LineLayerEditor" DataType="{x:Type lim:LineLayerSettings}">
            <StackPanel>
                <CheckBox Content="{loc:Loc Editor_Show}" Margin="0,6,0,4"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                <ctl:SliderField Label="{loc:Loc Editor_Opacity}" Range="{x:Static lim:CrosshairLimits.Opacity}"
                                 Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Tách độ dài dọc thì thanh này chỉ còn là độ dài NGANG — đổi nhãn cho khỏi hiểu nhầm. -->
                <ctl:SliderField Range="{x:Static lim:CrosshairLimits.LineLength}"
                                 Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ctl:SliderField.Style>
                        <Style TargetType="ctl:SliderField">
                            <Setter Property="Label" Value="{loc:Loc Editor_Length}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeparateVerticalLength, Mode=OneWay}" Value="True">
                                    <Setter Property="Label" Value="{loc:Loc Editor_HorizontalLength}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:SliderField.Style>
                </ctl:SliderField>
                <CheckBox Content="{loc:Loc Editor_SeparateVertical}" Margin="0,4,0,4"
                          IsChecked="{Binding SeparateVerticalLength, Mode=TwoWay}"/>
                <ctl:SliderField Label="{loc:Loc Editor_VerticalLength}" Range="{x:Static lim:CrosshairLimits.LineLength}"
                                 Value="{Binding VerticalLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding SeparateVerticalLength,
                                              Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                <ctl:SliderField Label="{loc:Loc Editor_Thickness}" Range="{x:Static lim:CrosshairLimits.LineThickness}"
                                 Value="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ctl:SliderField Label="{loc:Loc Editor_Offset}" Range="{x:Static lim:CrosshairLimits.LineOffset}"
                                 Value="{Binding Offset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{loc:Loc Editor_RoundedCaps}" Margin="0,8,0,4"
                          IsChecked="{Binding RoundedCaps, Mode=TwoWay}"/>
                <!-- 2 cột: bốn nút gạt trên một hàng không đủ chỗ trong cột chỉnh sửa. -->
                <UniformGrid Columns="2" Margin="0,2,0,0">
                    <CheckBox Content="{loc:Loc Editor_Top}" Margin="0,4"
                              IsChecked="{Binding ShowTop, Mode=TwoWay}"/>
                    <CheckBox Content="{loc:Loc Editor_Bottom}" Margin="0,4"
                              IsChecked="{Binding ShowBottom, Mode=TwoWay}"/>
                    <CheckBox Content="{loc:Loc Editor_Left}" Margin="0,4"
                              IsChecked="{Binding ShowLeft, Mode=TwoWay}"/>
                    <CheckBox Content="{loc:Loc Editor_Right}" Margin="0,4"
                              IsChecked="{Binding ShowRight, Mode=TwoWay}"/>
                </UniformGrid>
            </StackPanel>
        </DataTemplate>

        <!--
            Khung chỗ-trống của cột chỉnh sửa: cùng nền thẻ, chỉ thêm một dòng chữ mờ. Rẻ tới mức
            không đo được, nhưng khiến khoảnh khắc chờ trông như đang tải chứ không như hỏng.
        -->
        <DataTemplate x:Key="EditorPlaceholder">
            <Border Style="{StaticResource Card}">
                <TextBlock Text="{loc:Loc Editor_Loading}" Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!--
            Nội dung tab "Thư viện"; chỉ dựng khi người dùng bấm sang tab đó lần đầu (xem
            SettingsWindow.OnTabChanged). Nhờ vậy khởi động app không đụng tới file thư viện mẫu.
        -->
        <DataTemplate x:Key="LibraryPanel">
            <views:PresetLibraryView DataContext="{Binding Library}"/>
        </DataTemplate>

        <!-- Nội dung cột trình chỉnh sửa; dựng trễ một nhịp sau khi cửa sổ đã hiện. -->
        <DataTemplate x:Key="EditorPanel">
                        <Border Style="{StaticResource Card}" Padding="6,0,6,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0">
                                <StackPanel Margin="0,4,8,16">

                                    <!-- Chế độ đứng TRÊN CÙNG: nó quyết định mọi thứ bên dưới hiện hay ẩn. -->
                                    <TextBlock Text="{loc:Loc Editor_Mode}" Style="{StaticResource SectionHeader}"
                                               Margin="0,12,0,6"/>
                                    <ComboBox ItemsSource="{Binding Editor.Types}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Editor.Profile.Type, Mode=TwoWay}"/>

                                    <TextBlock Text="{loc:Loc Editor_General}" Style="{StaticResource SectionHeader}"
                                               Margin="0,16,0,6"/>

                                    <TextBlock Text="{loc:Loc Editor_PresetName}" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Editor.Profile.Name, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Hình dạng, màu, độ mờ và tỉ lệ tổng thể chỉ có nghĩa với tâm ngắm vẽ tay;
                                         chế độ ảnh có thanh độ mờ/kích thước riêng trong nhóm Hình ảnh. -->
                                    <StackPanel Visibility="{Binding Editor.IsStandardMode,
                                                Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <TextBlock Text="{loc:Loc Editor_Shape}" Style="{StaticResource FieldLabel}"
                                                   Margin="0,12,0,4"/>
                                        <ComboBox ItemsSource="{Binding Editor.Shapes}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Editor.Profile.Shape, Mode=TwoWay}"/>

                                        <TextBlock Text="{loc:Loc Editor_Color}" Style="{StaticResource FieldLabel}"
                                                   Margin="0,12,0,4"/>
                                        <ctl:ColorPickerButton SelectedColor="{Binding Editor.Profile.Color, Mode=TwoWay}"/>

                                        <ctl:SliderField Label="{loc:Loc Editor_Opacity}" Range="{x:Static lim:CrosshairLimits.Opacity}"
                                                         Margin="0,8,0,0"
                                                         Value="{Binding Editor.Profile.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ctl:SliderField Label="{loc:Loc Editor_Scale}" Range="{x:Static lim:CrosshairLimits.Scale}"
                                                         Value="{Binding Editor.Profile.Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <ctl:SliderField Label="{loc:Loc Editor_Rotation}" Range="{x:Static lim:CrosshairLimits.Rotation}"
                                                     Value="{Binding Editor.Profile.Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- ===== Tâm giữa → Nhánh trong → Nhánh ngoài: đúng thứ tự renderer vẽ ===== -->
                                    <Expander Header="{loc:Loc Editor_CenterDot}" Style="{StaticResource SettingsExpander}"
                                              Margin="0,16,0,0"
                                              Tag="{Binding Editor.Profile.CenterDot.Enabled, Mode=OneWay}"
                                              Visibility="{Binding Editor.IsStandardMode,
                                                           Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <StackPanel>
                                            <CheckBox Content="{loc:Loc Editor_Show}" Margin="0,6,0,4"
                                                      IsChecked="{Binding Editor.Profile.CenterDot.Enabled, Mode=TwoWay}"/>
                                            <ctl:SliderField Label="{loc:Loc Editor_Opacity}" Range="{x:Static lim:CrosshairLimits.Opacity}"
                                                             Value="{Binding Editor.Profile.CenterDot.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ctl:SliderField Label="{loc:Loc Editor_Size}" Range="{x:Static lim:CrosshairLimits.DotSize}"
                                                             Value="{Binding Editor.Profile.CenterDot.Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Content="{loc:Loc Editor_UseProfileColor}" Margin="0,8,0,4"
                                                      IsChecked="{Binding Editor.Profile.CenterDot.UseProfileColor, Mode=TwoWay}"/>
                                            <ctl:ColorPickerButton
                                                SelectedColor="{Binding Editor.Profile.CenterDot.Color, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Visibility="{Binding Editor.ShowLineSettings,
                                                Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <Expander Header="{loc:Loc Editor_InnerLines}" Style="{StaticResource SettingsExpander}"
                                                  Tag="{Binding Editor.Profile.InnerLines.Enabled, Mode=OneWay}"
                                                  Content="{Binding Editor.Profile.InnerLines, Mode=OneWay}"
                                                  ContentTemplate="{StaticResource LineLayerEditor}"/>

                                        <Expander Header="{loc:Loc Editor_OuterLines}" Style="{StaticResource SettingsExpander}"
                                                  Tag="{Binding Editor.Profile.OuterLines.Enabled, Mode=OneWay}"
                                                  Content="{Binding Editor.Profile.OuterLines, Mode=OneWay}"
                                                  ContentTemplate="{StaticResource LineLayerEditor}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Editor.ShowRingSettings,
                                                Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <TextBlock Text="{loc:Loc Editor_Ring}" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox Content="{loc:Loc Editor_ShowRing}" Margin="0,0,0,6"
                                                  IsChecked="{Binding Editor.Profile.Ring.Enabled, Mode=TwoWay}"/>
                                        <ctl:SliderField Label="{loc:Loc Editor_Radius}" Range="{x:Static lim:CrosshairLimits.RingRadius}"
                                                         Value="{Binding Editor.Profile.Ring.Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ctl:SliderField Label="{loc:Loc Editor_Thickness}" Range="{x:Static lim:CrosshairLimits.RingThickness}"
                                                         Value="{Binding Editor.Profile.Ring.Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Content="{loc:Loc Editor_Filled}" Margin="0,8,0,0"
                                                  IsChecked="{Binding Editor.Profile.Ring.Filled, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Editor.ShowOutlineSettings,
                                                Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <TextBlock Text="{loc:Loc Editor_Outline}" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox Content="{loc:Loc Editor_ShowOutline}" Margin="0,0,0,6"
                                                  IsChecked="{Binding Editor.Profile.Outline.Enabled, Mode=TwoWay}"/>
                                        <ctl:SliderField Label="{loc:Loc Editor_Thickness}" Range="{x:Static lim:CrosshairLimits.OutlineThickness}"
                                                         Value="{Binding Editor.Profile.Outline.Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ctl:SliderField Label="{loc:Loc Editor_Opacity}" Range="{x:Static lim:CrosshairLimits.Opacity}"
                                                         Value="{Binding Editor.Profile.Outline.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ctl:ColorPickerButton Margin="0,6,0,0"
                                            SelectedColor="{Binding Editor.Profile.Outline.Color, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- ===== Chế độ ảnh: thay thế toàn bộ nhóm vẽ tay ===== -->
                                    <Expander Header="{loc:Loc Editor_Image}" Style="{StaticResource SettingsExpander}"
                                              Margin="0,16,0,0"
                                              Tag="{Binding Editor.IsImageMode, Mode=OneWay}"
                                              Visibility="{Binding Editor.ShowImageSettings,
                                                           Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                                       Margin="0,8,0,8" Text="{Binding Editor.ImagePathDisplay, Mode=OneWay}"/>
                                            <UniformGrid Columns="2">
                                                <Button Content="{loc:Loc Editor_BrowseImage}" Style="{StaticResource AccentButton}"
                                                        Command="{Binding Editor.BrowseImageCommand}" Margin="0,0,3,0"/>
                                                <Button Content="{loc:Loc Editor_ClearImage}"
                                                        Command="{Binding Editor.ClearImageCommand}" Margin="3,0,0,0"/>
                                            </UniformGrid>

                                            <ctl:SliderField Label="{loc:Loc Editor_ImageScale}" Range="{x:Static lim:CrosshairLimits.ImageScale}"
                                                             Margin="0,10,0,0"
                                                             Value="{Binding Editor.Profile.Image.Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ctl:SliderField Label="{loc:Loc Editor_Opacity}" Range="{x:Static lim:CrosshairLimits.Opacity}"
                                                             Value="{Binding Editor.Profile.Image.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ctl:SliderField Label="{loc:Loc Editor_ImageOffsetX}" Range="{x:Static lim:CrosshairLimits.ImageOffset}"
                                                             Value="{Binding Editor.Profile.Image.OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ctl:SliderField Label="{loc:Loc Editor_ImageOffsetY}" Range="{x:Static lim:CrosshairLimits.ImageOffset}"
                                                             Value="{Binding Editor.Profile.Image.OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                                <Button Content="{loc:Loc Editor_ResetImageOffset}"
                                                        Command="{Binding Editor.ResetImageOffsetCommand}" Margin="0,0,3,0"/>
                                                <Button Content="{loc:Loc Editor_ResetRotation}"
                                                        Command="{Binding Editor.ResetRotationCommand}" Margin="3,0,0,0"/>
                                            </UniformGrid>

                                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                                       Margin="0,10,0,0" Foreground="{StaticResource TextMuted}"
                                                       Text="{loc:Loc Editor_ImageNote}"/>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Visibility="{Binding Editor.IsStandardMode,
                                                Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <TextBlock Text="{loc:Loc Editor_Position}" Style="{StaticResource SectionHeader}"/>
                                    <ctl:SliderField Label="{loc:Loc Editor_OffsetX}" Range="{x:Static lim:CrosshairLimits.Offset}"
                                                     Value="{Binding Editor.Profile.OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ctl:SliderField Label="{loc:Loc Editor_OffsetY}" Range="{x:Static lim:CrosshairLimits.Offset}"
                                                     Value="{Binding Editor.Profile.OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button Content="{loc:Loc Editor_ResetOffset}"
                                                Command="{Binding Editor.ResetOffsetCommand}" Margin="0,0,3,0"/>
                                        <Button Content="{loc:Loc Editor_ResetRotation}"
                                                Command="{Binding Editor.ResetRotationCommand}" Margin="3,0,0,0"/>
                                    </UniformGrid>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <!-- Góc thương hiệu: ô logo, tên ứng dụng, huy hiệu phiên bản, dòng mô tả ngắn. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusCard}"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                        Margin="0,0,12,0">
                    <Image Source="pack://application:,,,/images/BrandingLogo.ico" Margin="5"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static core:AppInfo.DisplayName}"
                                   FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#2600ED64" BorderBrush="{StaticResource Accent}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusInput}"
                                Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static core:AppInfo.DisplayVersion}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBright}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Static core:AppInfo.Tagline}" Style="{StaticResource FieldLabel}"
                               FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="480">
                <!-- Nút gạt chung với các tab (Theme: ToggleSwitch), chữ bên phải nút gạt như mọi nơi khác. -->
                <CheckBox Style="{StaticResource ToggleSwitch}" FontSize="13"
                          Content="{loc:Loc Shell_EnableOverlay}" HorizontalAlignment="Right"
                          IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"/>
                <!--
                    Nói rõ overlay SẼ hiện ở đâu theo chế độ đang chọn: người dùng hay tưởng app
                    hỏng khi bật overlay mà desktop không có gì. Rê chuột vào để xem lưu ý về chế
                    độ màn hình của game.
                -->
                <ContentControl Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                Margin="0,5,0,0"
                                Content="{Binding OverlayHint, Mode=OneWay}"
                                ToolTip="{loc:Loc Shell_OverlayDisplayModeTip}"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" SelectionChanged="OnTabChanged">

            <!-- ============================================ TAB CROSSHAIR -->
            <TabItem Header="{loc:Loc Tab_Crosshair}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Preset_Header}"
                                       Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>

                            <!-- Hành động chính của cột: nút lớn, trên cùng, kéo hết chiều ngang. -->
                            <Button DockPanel.Dock="Top" Content="{loc:Loc Preset_New}"
                                    Command="{Binding NewPresetCommand}"
                                    Style="{StaticResource PrimaryWideButton}" Margin="0,0,0,10"/>

                            <!--
                                Cụm dưới cùng, từ trên xuống: kiểm tra → chia sẻ (mã văn bản) → quản lý.
                                Tự lưu preset vào AppData không phụ thuộc vào nút nào ở đây.
                            -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button Content="{loc:Loc Preset_TestCrosshair}" Command="{Binding TestCrosshairCommand}"
                                        ToolTip="{loc:Loc Preset_TestCrosshairTip}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <UniformGrid Columns="2">
                                    <Button Content="{loc:Loc Preset_FromGameCode}" Command="{Binding ImportCodeCommand}"
                                            ToolTip="{loc:Loc Preset_FromGameCodeTip}" Margin="0,4,3,4"/>
                                    <Button Content="{loc:Loc Preset_ExportCode}" Command="{Binding ExportCodeCommand}"
                                            IsEnabled="{Binding SelectedPreset, Converter={StaticResource NotNullToBool}, Mode=OneWay}"
                                            ToolTip="{loc:Loc Preset_ExportCodeTip}" Margin="3,4,0,4"/>
                                    <Button Content="{loc:Loc Preset_Duplicate}" Command="{Binding DuplicatePresetCommand}"
                                            IsEnabled="{Binding SelectedPreset, Converter={StaticResource NotNullToBool}, Mode=OneWay}"
                                            Margin="0,4,3,0"/>
                                    <Button Content="{loc:Loc Preset_Delete}" Command="{Binding DeletePresetCommand}"
                                            IsEnabled="{Binding SelectedPreset, Converter={StaticResource NotNullToBool}, Mode=OneWay}"
                                            Style="{StaticResource DangerButton}" Margin="3,4,0,0"/>
                                </UniformGrid>
                            </StackPanel>

                            <ContentControl DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,8,0,0"
                                            Content="{loc:Loc Preset_DragToReorder}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!--
                                    Phím Delete gọi ĐÚNG lệnh của nút "Xoá", nên vẫn qua hộp thoại
                                    xác nhận — không có đường xoá tắt nào bỏ qua bước hỏi lại.
                                    Kéo thả để đổi thứ tự (DragReorder): thứ tự lưu vào settings.json và là
                                    thứ tự của phím tắt Preset kế tiếp / trước đó.
                                -->
                                <ListBox ItemsSource="{Binding Presets}"
                                         SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="OnPresetSelectionChanged"
                                         ctl:DragReorder.MoveCommand="{Binding MovePresetToCommand}">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Delete" Command="{Binding DeletePresetCommand}"/>
                                    </ListBox.InputBindings>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}"
                                    CornerRadius="0,0,6,6" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{loc:Loc Preview_Zoom}"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Margin="12,0" Minimum="1" Maximum="16"
                                            VerticalAlignment="Center"
                                            Value="{Binding Editor.PreviewZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <CheckBox Content="{loc:Loc Preview_Checkerboard}" Margin="0,0,16,0"
                                                  IsChecked="{Binding Editor.ShowCheckerboard, Mode=TwoWay}"/>
                                        <CheckBox Content="{loc:Loc Preview_DarkBackground}"
                                                  IsChecked="{Binding Editor.UseDarkPreviewBackground, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ctl:CrosshairPreview
                                Profile="{Binding Editor.Profile, Mode=OneWay}"
                                Renderer="{Binding Editor.Renderer, Mode=OneWay}"
                                Zoom="{Binding Editor.PreviewZoom, Mode=OneWay}"
                                ShowCheckerboard="{Binding Editor.ShowCheckerboard, Mode=OneWay}"
                                UseDarkBackground="{Binding Editor.UseDarkPreviewBackground, Mode=OneWay}"/>
                        </DockPanel>
                    </Border>

                    <!--
                        Cột trình chỉnh sửa nạp SAU khung hình đầu tiên (xem SettingsWindow.xaml.cs).
                        Đo thực tế: riêng cột này tốn ~450 ms trong tổng ~1000 ms dựng cửa sổ, nên nạp
                        ngay từ đầu là bắt người dùng nhìn màn hình trống thêm gần nửa giây. Nội dung
                        nằm trong DataTemplate nên chỉ dựng khi ContentTemplate được gán.
                    -->
                    <ContentControl x:Name="EditorHost" Grid.Column="4" Content="{Binding}"
                                    ContentTemplate="{StaticResource EditorPlaceholder}"/>
                </Grid>
            </TabItem>

            <!-- ============================================ TAB CHUNG -->
            <!-- Hai cột bằng nhau: màn hình bên trái, ứng dụng + cập nhật bên phải — dàn đều hết cửa sổ. -->
            <TabItem Header="{loc:Loc Tab_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ======== Cột trái: MÀN HÌNH + HIỆU NĂNG -->
                        <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc General_Monitor}" Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding General.MonitorModes}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding General.MonitorMode, Mode=TwoWay}"/>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding General.ShowMonitorPicker,
                                                         Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <ComboBox ItemsSource="{Binding General.AvailableMonitors}"
                                              SelectedItem="{Binding General.PinnedMonitor, Mode=TwoWay}"
                                              DisplayMemberPath="DeviceName"/>
                                </StackPanel>

                                <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="12,8">
                                    <ItemsControl ItemsSource="{Binding General.AvailableMonitors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource FieldLabel}" FontFamily="Consolas"
                                                           FontSize="11" Margin="0,2" TextWrapping="Wrap">
                                                    <Run Text="{Binding DeviceName, Mode=OneWay}"/>
                                                    <Run Text="{Binding Bounds, Mode=OneWay, StringFormat='· {0}'}"/>
                                                    <Run Text="{Binding DpiScaleX, Mode=OneWay, StringFormat='· DPI {0:0.##}x'}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Button Content="{loc:Loc General_RefreshMonitors}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Command="{Binding General.RefreshMonitorsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!--
                            HIỆU NĂNG. FPS giới hạn tần số dựng lại hình khi đang chỉnh và tần số đổi khung GIF —
                            tâm ngắm tĩnh không vẽ lại liên tục nên lúc chơi con số này gần như không tốn gì.
                        -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Perf_Header}" Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Perf_FpsLimit}" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding General.FpsLimits}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding General.OverlayFpsLimit, Mode=TwoWay}"/>

                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,16,0,2"
                                          Content="{loc:Loc Perf_HardwareAcceleration}"
                                          ToolTip="{loc:Loc Perf_HardwareAccelerationTip}"
                                          IsChecked="{Binding General.UseHardwareAcceleration, Mode=TwoWay}"/>

                                <TextBlock Text="{loc:Loc Perf_Priority}" Style="{StaticResource FieldLabel}"
                                           Margin="0,16,0,4"/>
                                <ComboBox ItemsSource="{Binding General.PriorityModes}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          ToolTip="{loc:Loc Perf_PriorityTip}"
                                          SelectedValue="{Binding General.ProcessPriority, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <!--
                            BẢO VỆ MÀN HÌNH. Dịch cả cửa sổ overlay đúng 1 pixel vật lý mỗi 2 phút (lên → phải →
                            xuống → trái), tắt là về tâm ngay. Xem OverlayBehaviorController.
                        -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Oled_Header}" Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,8"/>

                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,2,0,4"
                                          Content="{loc:Loc Oled_PixelShift}"
                                          IsChecked="{Binding General.EnableOledPixelShift, Mode=TwoWay}"/>
                                <ContentControl Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                Content="{loc:Loc Oled_PixelShiftHint}"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- ======== Cột phải: ỨNG DỤNG (gồm cập nhật) + DỮ LIỆU & BẢO TRÌ -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc General_App}" Style="{StaticResource SectionHeader}"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="{loc:Loc General_Language}" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding General.Languages}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding General.LanguageCode, Mode=TwoWay}"/>

                                    <CheckBox Content="{loc:Loc General_StartWithWindows}" Margin="0,14,0,4"
                                              IsChecked="{Binding General.StartWithWindows, Mode=TwoWay}"/>
                                    <TextBlock Text="{Binding General.StartupHint, Mode=OneWay}" Style="{StaticResource FieldLabel}"
                                               TextWrapping="Wrap" Margin="46,0,0,4"/>
                                    <CheckBox Content="{loc:Loc General_StartMinimized}" Margin="0,6"
                                              IsChecked="{Binding General.Settings.StartMinimizedToTray, Mode=TwoWay}"
                                              Command="{Binding General.PersistSettingsCommand}"/>
                                    <CheckBox Content="{loc:Loc General_MinimizeOnClose}" Margin="0,6"
                                              IsChecked="{Binding General.Settings.MinimizeToTrayOnClose, Mode=TwoWay}"
                                              Command="{Binding General.PersistSettingsCommand}"/>
                                    <CheckBox Content="{loc:Loc General_WarnExclusive}" Margin="0,6"
                                              IsChecked="{Binding General.Settings.WarnOnExclusiveFullscreen, Mode=TwoWay}"
                                              Command="{Binding General.PersistSettingsCommand}"/>

                                    <!--
                                        Cập nhật nằm CHUNG thẻ với ứng dụng, không tách riêng: cột này cao
                                        hơn khung nhìn nên thẻ cuối ("Dữ liệu & bảo trì") bị hụt một nửa ở
                                        mép dưới. Bỏ một tiêu đề nhóm và một khung thẻ là đủ chỗ, mà nội
                                        dung vẫn đúng chỗ — cập nhật cũng là chuyện của ứng dụng.
                                    -->
                                    <TextBlock Text="{loc:Loc Update_Header}" Style="{StaticResource SectionHeader}"
                                               Margin="0,12,0,6"/>
                                    <CheckBox Content="{loc:Loc Update_AutoCheck}" Margin="0,2,0,6"
                                              IsChecked="{Binding General.Settings.CheckForUpdates, Mode=TwoWay}"
                                              Command="{Binding General.PersistSettingsCommand}"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Kết quả hiện bằng thông báo nhỏ ở góc cửa sổ, xem Toast bên dưới. -->
                                        <Button Content="{loc:Loc Update_CheckNow}"
                                                Command="{Binding General.CheckForUpdatesCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DỮ LIỆU & BẢO TRÌ: nút nguy hiểm dùng màu đỏ và luôn qua hộp thoại xác nhận. -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Data_Header}" Style="{StaticResource SectionHeader}"
                                               Margin="0,0,0,8"/>

                                    <!-- Vị trí lưu trữ: đường dẫn chỉ đọc + nút đổi. Đổi xong phải khởi động lại mới áp dụng. -->
                                    <TextBlock Text="{loc:Loc Storage_Label}" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding General.DataDirectory, Mode=OneWay}"
                                                 ToolTip="{Binding General.DataDirectory, Mode=OneWay}"/>
                                        <Button Grid.Column="1" Content="{loc:Loc Storage_Change}" Margin="8,0,0,0"
                                                Command="{Binding General.ChangeStorageLocationCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Storage_Copying}" Style="{StaticResource FieldLabel}"
                                               FontSize="11.5" Margin="0,2,0,0"
                                               Visibility="{Binding General.IsChangingStorage,
                                                            Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                    <Border Height="12"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="{loc:Loc Data_OpenFolder}" Margin="0,0,5,0"
                                                ToolTip="{loc:Loc Data_OpenFolderTip}"
                                                Command="{Binding General.OpenDataFolderCommand}"/>
                                        <Button Content="{loc:Loc Data_Reset}" Margin="5,0,0,0"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="{loc:Loc Data_ResetTip}"
                                                Command="{Binding General.FactoryResetCommand}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================ TAB PHÍM TẮT -->
            <!--
                Lưới 2x2: hàng trên là PHÍM TẮT | THÔNG TIN HỆ THỐNG (hai thẻ cao bằng nhau), hàng dưới là HÀNH VI
                NÂNG CAO trải hết chiều ngang. Ở kích thước mặc định vừa khít, không có thanh cuộn. ScrollViewer
                chỉ là lưới an toàn khi người dùng thu cửa sổ thấp hơn nội dung (thanh cuộn chỉ hiện lúc đó).
            -->
            <TabItem Header="{loc:Loc Tab_Hotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- MinHeight = vùng nhìn thấy: đủ chỗ thì hàng trên lấp phần dư, thiếu chỗ thì cuộn. -->
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Hotkeys_Header}" Style="{StaticResource SectionHeader}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                               Margin="0,0,0,6" Text="{loc:Loc Hotkeys_Intro}"/>
                                    <ContentControl Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                    Content="{loc:Loc Hotkeys_ComboHint}"/>

                                    <!--
                                        Lưới 3 cột thẳng hàng giữa mọi dòng: tên chức năng | ô nhập phím | nút gạt.
                                        Grid.IsSharedSizeScope để cột 1 và 3 rộng bằng nhau ở mọi dòng dù nhãn dài
                                        ngắn khác nhau. Lỗi đăng ký (nếu có) nằm ở dòng phụ, dưới ô nhập phím.
                                    -->
                                    <ItemsControl ItemsSource="{Binding Hotkeys.Rows}" Grid.IsSharedSizeScope="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 3 DIP trên/dưới: đủ tách dòng, và là phần để cả tab vừa khít không cần cuộn. -->
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel" MinWidth="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyToggle"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Label, Mode=OneWay}" Margin="0,0,16,0"
                                                               Style="{StaticResource FieldLabel}"/>

                                                    <ctl:HotkeyInputBox Grid.Column="1" MaxWidth="320" HorizontalAlignment="Stretch"
                                                        Style="{StaticResource {x:Type TextBox}}"
                                                        HotkeyKey="{Binding Binding.Key, Mode=TwoWay}"
                                                        HotkeyMouseButton="{Binding Binding.MouseButton, Mode=TwoWay}"
                                                        HotkeyModifiers="{Binding Binding.Modifiers, Mode=TwoWay}"/>

                                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                                                              ToolTip="{loc:Loc Hotkeys_Enabled}"
                                                              IsChecked="{Binding Binding.Enabled, Mode=TwoWay}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                               Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5"
                                                               Foreground="{StaticResource Danger}"
                                                               Text="{Binding Binding.RegistrationError, Mode=OneWay}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                    <Trigger Property="Text" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sát ngay dưới dòng phím tắt cuối cùng. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{loc:Loc Hotkeys_Apply}" Style="{StaticResource AccentButton}"
                                                Command="{Binding Hotkeys.ApplyHotkeysCommand}" Margin="0,0,10,0"/>
                                        <Button Content="{loc:Loc Hotkeys_Reset}"
                                                Command="{Binding Hotkeys.ResetToDefaultsCommand}"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Text="{Binding Hotkeys.StatusMessage, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!--
                                HÀNH VI NÂNG CAO, trải ngang hai cột: bên trái hai quy tắc ẩn tạm thời (chồng lên
                                quy tắc hiện/ẩn của game profile), bên phải đổi màu khi bắn và màu của nó.
                            -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Adv_Header}" Style="{StaticResource SectionHeader}"
                                               Margin="0,0,0,8"/>

                                    <!-- Cùng cột 14 DIP ở giữa như hàng trên: cột phải thẳng mép với thẻ Thông tin hệ thống. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!--
                                            Mỗi cột một StackPanel căn trên: nút gạt đầu của hai cột luôn cùng hàng, không
                                            phụ thuộc chiều cao ô màu ở cột phải.
                                        -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                                                      Margin="0,2,0,0"
                                                      Content="{loc:Loc Adv_HideOnRightClick}"
                                                      ToolTip="{loc:Loc Adv_HideOnRightClickTip}"
                                                      IsChecked="{Binding Hotkeys.HideOnRightClick, Mode=TwoWay}"/>

                                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                                                      Margin="0,8,0,0"
                                                      Content="{loc:Loc Adv_OnlyWhenCursorHidden}"
                                                      ToolTip="{loc:Loc Adv_OnlyWhenCursorHiddenTip}"
                                                      IsChecked="{Binding Hotkeys.ShowOnlyWhenCursorHidden, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <!--
                                            Màu khi bắn: chỉ đổi màu lúc vẽ, không sửa preset (xem IOverlayController).
                                            Một khối căn trái: nút gạt, bên dưới là nhãn + ô màu thẳng mép trái với nút gạt.
                                        -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <CheckBox x:Name="FiringColorToggle" Style="{StaticResource ToggleSwitch}"
                                                      Margin="0,2,0,0" HorizontalAlignment="Left"
                                                      Content="{loc:Loc Adv_ChangeColorWhileFiring}"
                                                      ToolTip="{loc:Loc Adv_ChangeColorWhileFiringTip}"
                                                      IsChecked="{Binding Hotkeys.ChangeColorWhileFiring, Mode=TwoWay}"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Style="{StaticResource DependentGroup}"
                                                        IsEnabled="{Binding IsChecked, ElementName=FiringColorToggle}">
                                                <TextBlock Text="{loc:Loc Adv_FiringColor}" Style="{StaticResource FieldLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <ctl:ColorPickerButton VerticalAlignment="Center"
                                                    SelectedColor="{Binding Hotkeys.FiringColor, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                    <!-- ======== THÔNG TIN HỆ THỐNG (đọc trên luồng nền, xem SystemInfoViewModel) -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Hw_Title}" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,10"/>

                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style x:Key="HwLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                    <Style x:Key="HwValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Hw_Os}" Style="{StaticResource HwLabel}"/>
                                        <TextBlock Text="{Binding SystemInfo.OsInfo, Mode=OneWay}" Style="{StaticResource HwValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Hw_Cpu}" Style="{StaticResource HwLabel}"/>
                                        <TextBlock Text="{Binding SystemInfo.CpuName, Mode=OneWay}" Style="{StaticResource HwValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Hw_Gpu}" Style="{StaticResource HwLabel}"/>
                                        <TextBlock Text="{Binding SystemInfo.GpuName, Mode=OneWay}" Style="{StaticResource HwValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Hw_Ram}" Style="{StaticResource HwLabel}"/>
                                        <TextBlock Text="{Binding SystemInfo.RamInfo, Mode=OneWay}" Style="{StaticResource HwValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Hw_Display}" Style="{StaticResource HwLabel}"/>
                                        <TextBlock Text="{Binding SystemInfo.DisplayInfo, Mode=OneWay}" Style="{StaticResource HwValue}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================ TAB GAME -->
            <TabItem Header="{loc:Loc Tab_Games}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Games_Header}"
                                       Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button Content="{loc:Loc Games_AddEmpty}" Style="{StaticResource AccentButton}"
                                        Command="{Binding Games.BeginNewProfileCommand}" Margin="0,0,0,6"/>
                                <Button Content="{loc:Loc Games_AddFromCurrent}"
                                        Command="{Binding Games.AddFromCurrentWindowCommand}" Margin="0,0,0,6"/>
                                <Button Content="{loc:Loc Games_AddMock}"
                                        Command="{Binding Games.AddMockTargetCommand}"
                                        ToolTip="{loc:Loc Games_AddMockTip}" Margin="0,0,0,6"/>
                                <Button Content="{loc:Loc Games_Remove}" Style="{StaticResource DangerButton}"
                                        Command="{Binding Games.RemoveProfileCommand}"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Games.Profiles}"
                                         SelectedItem="{Binding Games.SelectedProfile, Mode=TwoWay}"
                                         DisplayMemberPath="Name"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,16">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                                              Margin="0,0,0,8"
                                              Content="{loc:Loc Games_AutoSwitch}"
                                              IsChecked="{Binding Games.AutoSwitchEnabled, Mode=TwoWay}"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                                              Margin="0,8,0,0"
                                              Content="{loc:Loc Games_OnlyMatched}"
                                              IsChecked="{Binding Games.ShowOnlyInMatchedGames, Mode=TwoWay}"/>
                                    <TextBlock Text="{Binding Games.Hint, Mode=OneWay}" Style="{StaticResource FieldLabel}"
                                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== Khung tạo profile mới, mở ngay tại chỗ ===== -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                    BorderBrush="{StaticResource AccentBright}"
                                    Visibility="{Binding Games.IsCreatingProfile,
                                                 Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Games_NewProfile}"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                                    <TextBlock Text="{loc:Loc Games_RunningHeader}"
                                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:Loc Games_RunningHint}" Style="{StaticResource FieldLabel}"
                                               TextWrapping="Wrap" Margin="0,4,0,8"
                                               Foreground="{StaticResource TextMuted}"/>

                                    <Border Style="{StaticResource InnerCard}" Padding="6" Height="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ListBox ItemsSource="{Binding Games.RunningApps}"
                                                     SelectedItem="{Binding Games.SelectedRunningApp, Mode=TwoWay}"
                                                     DisplayMemberPath="Display"/>
                                        </ScrollViewer>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{loc:Loc Games_UseSelected}"
                                                Command="{Binding Games.UseSelectedRunningAppCommand}"
                                                IsEnabled="{Binding Games.SelectedRunningApp,
                                                            Converter={StaticResource NotNullToBool}, Mode=OneWay}"
                                                Margin="0,0,10,0"/>
                                        <Button Content="{loc:Loc Games_RefreshRunning}"
                                                Command="{Binding Games.ScanRunningAppsCommand}"/>
                                    </StackPanel>

                                    <StackPanel DataContext="{Binding Games.Draft}" Margin="0,16,0,0">
                                        <TextBlock Text="{loc:Loc Games_DisplayName}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Name, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="{loc:Loc Games_MatchMode}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                        <ComboBox ItemsSource="{Binding DataContext.Games.MatchModes,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding MatchMode, Mode=TwoWay}"/>

                                        <TextBlock Text="{loc:Loc Games_Pattern}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                        <TextBox Text="{Binding Pattern, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="{loc:Loc Games_Behavior}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                        <ComboBox ItemsSource="{Binding DataContext.Games.Behaviors,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Behavior, Mode=TwoWay}"/>

                                        <TextBlock Text="{loc:Loc Games_Preset}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                        <ComboBox ItemsSource="{Binding DataContext.Games.Presets,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectedValue="{Binding PresetId, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{loc:Loc Games_Save}" Style="{StaticResource AccentButton}"
                                                Command="{Binding Games.SaveNewProfileCommand}" Margin="0,0,10,0"/>
                                        <Button Content="{loc:Loc Games_CancelNew}"
                                                Command="{Binding Games.CancelNewProfileCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ===== Bảng chẩn đoán ===== -->
                            <Border Style="{StaticResource InnerCard}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Games_Diagnostics}"
                                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Games_Process}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,3" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11.5"
                                                   Text="{Binding Games.DetectedProcess, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Games_WindowTitle}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11.5"
                                                   Text="{Binding Games.DetectedTitle, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Games_DisplayMode}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11.5"
                                                   Text="{Binding Games.DetectedDisplayMode, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Games_MatchedProfile}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11.5"
                                                   Foreground="{StaticResource AccentBright}"
                                                   Text="{Binding Games.DetectedMatch, Mode=OneWay}"/>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11.5"
                                               Foreground="{StaticResource Warning}"
                                               Visibility="{Binding Games.ProcessNameBlocked,
                                                            Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                               Text="{loc:Loc Games_AdminWarning}"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== Chi tiết profile đang chọn ===== -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding Games.SelectedProfile,
                                                 Converter={StaticResource NotNullToVisibility}, Mode=OneWay}">
                                <StackPanel MaxWidth="460" HorizontalAlignment="Left"
                                            DataContext="{Binding Games.SelectedProfile}">

                                    <TextBlock Text="{loc:Loc Games_Details}" Style="{StaticResource SectionHeader}"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="{loc:Loc Games_DisplayName}"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="{loc:Loc Games_MatchMode}"
                                               Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Games.MatchModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding MatchMode, Mode=TwoWay}"/>

                                    <TextBlock Text="{loc:Loc Games_Pattern}"
                                               Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="{loc:Loc Games_Behavior}"
                                               Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Games.Behaviors,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Behavior, Mode=TwoWay}"/>

                                    <TextBlock Text="{loc:Loc Games_Preset}"
                                               Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Games.Presets,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding PresetId, Mode=TwoWay}"/>

                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                                              Content="{loc:Loc Games_EnableProfile}" Margin="0,14,0,0"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================================ TAB THƯ VIỆN -->
            <TabItem x:Name="LibraryTab" Header="{loc:Loc Tab_Library}">
                <!-- Trống cho tới lần đầu người dùng bấm vào tab; xem OnTabChanged. -->
                <ContentControl x:Name="LibraryHost" Content="{Binding}"/>
            </TabItem>

        </TabControl>

        <!--
            Thông báo nhỏ dùng chung cho cả cửa sổ (vd kết quả "Kiểm tra cập nhật"). Nằm ngoài TabControl nên đổi tab
            không làm nó biến mất, và không nhận chuột nên không che nút nào bên dưới.
        -->
        <Border Grid.Row="1" Style="{StaticResource Toast}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Toast.Text}" FontSize="13" TextWrapping="Wrap" MaxWidth="460"/>
        </Border>
    </Grid>
</Window>
