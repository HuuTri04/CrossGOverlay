<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bảng màu theo MongoDB LeafyGreen (dark mode).
        Giữ nguyên tên token gốc để đối chiếu được với tài liệu thiết kế của họ; phần dưới ánh
        xạ sang tên theo vai trò, và toàn bộ giao diện chỉ dùng tên theo vai trò.
    -->
    <Color x:Key="LG.Black">#FF001E2B</Color>
    <Color x:Key="LG.Gray.Dark4">#FF112733</Color>
    <Color x:Key="LG.Gray.Dark3">#FF1C2D38</Color>
    <Color x:Key="LG.Gray.Dark2">#FF3D4F58</Color>
    <Color x:Key="LG.Gray.Dark1">#FF5C6C75</Color>
    <Color x:Key="LG.Gray.Base">#FF889397</Color>
    <Color x:Key="LG.Gray.Light1">#FFC1C7C6</Color>
    <Color x:Key="LG.Gray.Light2">#FFE8EDEB</Color>

    <Color x:Key="LG.Green.Dark2">#FF00684A</Color>
    <Color x:Key="LG.Green.Dark1">#FF00A35C</Color>
    <Color x:Key="LG.Green.Base">#FF00ED64</Color>
    <Color x:Key="LG.Green.Light2">#FFC0FAE6</Color>

    <Color x:Key="LG.Red.Base">#FFDB3030</Color>
    <Color x:Key="LG.Red.Light1">#FFFF6960</Color>
    <Color x:Key="LG.Yellow.Base">#FFFFC010</Color>

    <!-- ================= Vai trò ================= -->
    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource LG.Black}"/>
    <SolidColorBrush x:Key="PanelBg" Color="{StaticResource LG.Gray.Dark4}"/>
    <SolidColorBrush x:Key="CardBg" Color="{StaticResource LG.Gray.Dark3}"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource LG.Gray.Dark2}"/>
    <SolidColorBrush x:Key="TrackBg" Color="{StaticResource LG.Gray.Dark2}"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource LG.Green.Dark1}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource LG.Green.Base}"/>
    <SolidColorBrush x:Key="AccentBright" Color="{StaticResource LG.Green.Base}"/>

    <!-- Chữ trên nền xanh sáng phải là màu TỐI: xanh LeafyGreen quá chói để đặt chữ trắng lên. -->
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource LG.Black}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource LG.Gray.Light2}"/>
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource LG.Gray.Base}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource LG.Gray.Dark1}"/>
    <!-- Tiêu đề nhóm (MÀN HÌNH, ỨNG DỤNG, CHI TIẾT…): sáng hơn TextDim để đọc rõ trên nền Card tối. -->
    <SolidColorBrush x:Key="TextSubheader" Color="#FFA3B1C6"/>

    <SolidColorBrush x:Key="Danger" Color="{StaticResource LG.Red.Light1}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource LG.Yellow.Base}"/>
    <!--
        Lớp phủ sau hộp thoại: đen thuần, alpha 0x80 (50%). Cố tình KHÔNG pha màu nhấn của theme —
        pha xanh vào thì toàn bộ app phía sau bị nhuộm xanh thay vì chỉ tối đi.
    -->
    <SolidColorBrush x:Key="Backdrop" Color="#80000000"/>

    <!-- StaticResource chỉ nhìn thấy tài nguyên khai báo TRƯỚC nó, nên hai brush dưới đây
         phải nằm ở đây chứ không phải cạnh chỗ dùng. -->
    <SolidColorBrush x:Key="LG.Gray.Dark1Brush" Color="{StaticResource LG.Gray.Dark1}"/>
    <SolidColorBrush x:Key="LG.Green.Light2Brush" Color="{StaticResource LG.Green.Light2}"/>

    <!-- ================= Hình khối ================= -->
    <CornerRadius x:Key="RadiusInput">4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>

    <!-- ================= Kiểu chữ ================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSubheader}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ================= Button ================= -->
    <!-- Mặc định: dạng viền (secondary) theo LeafyGreen. -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <!-- 13 = đúng cỡ chữ các nút đang hiện, vốn do style TextBlock chung áp vào. -->
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInput}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}">
                            <!--
                                BẮT BUỘC. Nội dung nút là chuỗi nên WPF tự dựng một TextBlock, và style
                                TextBlock chung của theme (màu TextPrimary, cỡ 13) đặt thẳng lên nó — ghi
                                đè màu và cỡ chữ kế thừa từ Button. Thiếu đoạn này thì nút xanh và nút đỏ
                                đều ra chữ trắng: chữ trắng trên nền xanh sáng đọc rất chói, còn nút nguy
                                hiểm mất luôn màu đỏ cảnh báo. Lấy lại đúng hai giá trị đó từ Button.
                            -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Setter Property="FontSize"
                                            Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1400ED64"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2800ED64"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hành động chính: nền xanh đặc, chữ tối. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource Accent}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInput}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}">
                            <!--
                                BẮT BUỘC. Nội dung nút là chuỗi nên WPF tự dựng một TextBlock, và style
                                TextBlock chung của theme (màu TextPrimary, cỡ 13) đặt thẳng lên nó — ghi
                                đè màu và cỡ chữ kế thừa từ Button. Thiếu đoạn này thì nút xanh và nút đỏ
                                đều ra chữ trắng: chữ trắng trên nền xanh sáng đọc rất chói, còn nút nguy
                                hiểm mất luôn màu đỏ cảnh báo. Lấy lại đúng hai giá trị đó từ Button.
                            -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Setter Property="FontSize"
                                            Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBright}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
    </Style>

    <!-- ================= TextBox ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBright}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusInput}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô nhập số đứng cạnh slider: hẹp, canh phải, font đều nét. -->
    <Style x:Key="NumericBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--
        ================= CheckBox =================
        Style dùng chung cho MỌI CheckBox của ứng dụng (không đặt x:Key nên áp dụng tự động).
        Ô vuông 18x18 bo góc 4, dấu tick vẽ bằng <Path> vector — không dùng ký tự ✓ của font, vì
        glyph đổi hình theo font hệ thống và không canh giữa được chính xác ở mọi DPI.
        Không có animation hay Effect: đổi trạng thái chỉ bằng setter, không tạo clock nào.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <!-- 13 = đúng cỡ chữ các ô này đang hiện, vốn do style TextBlock chung áp vào nhãn. -->
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Nền trong suốt: cả hàng (ô vuông + chữ) đều là vùng bấm và vùng rê chuột. -->
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource WindowBg}"
                                BorderBrush="{StaticResource LG.Gray.Dark1Brush}" BorderThickness="1.5"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <!--
                                Toạ độ tuyệt đối (Stretch mặc định là None) và canh giữa trong ô: nét tick
                                không bị co giãn nên luôn sắc, dày đúng 2px ở mọi trạng thái.
                            -->
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  Data="M 0,3.6 L 3.5,7.2 L 9.6,0.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource OnAccent}" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True">
                            <!--
                                BẮT BUỘC. Content là chuỗi nên WPF tự dựng một TextBlock, và style TextBlock
                                chung của theme (màu TextPrimary, cỡ 13) đặt thẳng lên nó — ghi đè màu và cỡ
                                chữ kế thừa từ CheckBox. Thiếu đoạn này thì chữ luôn trắng cỡ 13, không đổi
                                theo trạng thái. Lấy lại đúng hai giá trị đó từ CheckBox.
                            -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
                                    <Setter Property="FontSize"
                                            Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Ô không có chữ (vd trong bảng phím tắt): bỏ luôn khoảng cách 8px. -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextDim}"/>
                        </Trigger>
                        <!-- Bàn phím (Tab tới rồi Space): phải thấy rõ ô nào đang được chọn. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                        <!--
                            Đứng SAU hai trigger trên nên thắng khi cùng đúng: ô đã tick vẫn giữ nền xanh
                            lúc rê chuột, chỉ viền sáng thêm.
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBright}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <!-- Giữ nguyên nền xanh, chỉ viền sáng lên: rê chuột không làm ô nhấp nháy đổi màu. -->
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LG.Green.Light2Brush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Nút gạt (toggle switch) kiểu LeafyGreen, dùng cho các ô bật/tắt: <CheckBox Style="{StaticResource ToggleSwitch}"/>.
        Vẫn là CheckBox bên dưới nên bàn phím (Space), binding IsChecked và trình đọc màn hình giữ nguyên.
        Không có animation hay Effect: đổi trạng thái bằng setter, không tạo clock nào.
    -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="{StaticResource TrackBg}"
                                BorderBrush="{StaticResource LG.Gray.Dark1Brush}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{StaticResource TextDim}"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slider ================= -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="16" Height="16">
                        <Ellipse x:Name="Knob" Fill="{StaticResource AccentBright}"
                                 Stroke="{StaticResource WindowBg}" StrokeThickness="2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource LG.Green.Light2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource TrackBg}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ComboBox ================= -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{StaticResource WindowBg}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusInput}">
                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,11,0" Data="M 0,0 L 4.5,5 L 9,0"
                              Stroke="{StaticResource TextDim}" StrokeThickness="1.6"
                              StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusInput}" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2600ED64"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#3300ED64"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="11,0,30,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource CardBg}"
                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Margin="0,4,0,0"
                                    Padding="0,3"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="280">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ListBox ================= -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{StaticResource RadiusInput}"
                            Padding="10,8" BorderThickness="0,0,0,0">
                        <Grid>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                    Background="Transparent" Margin="-6,0,0,0"/>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2600ED64"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TabControl ================= -->
    <!--
        Khung chứa nội dung tab ("thư mục"): sáng hơn nền cửa sổ một bậc (#001E2B → #112733) và tối hơn Card
        bên trong (#1C2D38) — ba lớp nền tạo chiều sâu. Nền ĐẶC, không mờ: tab đang chọn phải che được
        đúng 1px viền trên của khung, nền trong suốt thì viền vẫn lộ qua và ảo giác "một khối" bị gãy.
    -->
    <SolidColorBrush x:Key="TabContentBg" Color="{StaticResource LG.Gray.Dark4}"/>
    <!-- Viền mảnh: trắng 10% (#1AFFFFFF), đủ tách khung khỏi nền mà không thành đường kẻ gắt. -->
    <SolidColorBrush x:Key="TabContentBorder" Color="#1AFFFFFF"/>
    <CornerRadius x:Key="TabContentRadius">8</CornerRadius>

    <!--
        TabControl dạng thư mục: thanh tab ở trên, khung chứa (Border) bao toàn bộ nội dung bên dưới.
        Thanh tab đè xuống 1px (Margin -1, ZIndex 1): tab đang chọn có nền trùng màu khung và không có
        viền dưới, nên phủ lên viền trên của khung ngay dưới nó — tab và khung liền thành một khối, như
        chiếc hộp đang mở. Tab không chọn thì trong suốt, viền khung vẫn chạy ngang dưới chúng.
    -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource TabContentBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TabContentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1"
                                  Margin="0,0,0,-1" KeyboardNavigation.TabIndex="1" Background="Transparent"/>

                        <Border x:Name="Container" Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource TabContentRadius}"
                                Padding="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Tab đầu tiên đang chọn: góc trên-trái vuông để mép tab chạy thẳng xuống mép khung. -->
                        <Trigger Property="SelectedIndex" Value="0">
                            <Setter TargetName="Container" Property="CornerRadius" Value="0,8,8,8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nền tab khi rê chuột: sáng hơn nền cửa sổ một chút. -->
    <SolidColorBrush x:Key="TabHoverBg" Color="#FF1A2B35"/>

    <!--
        Thanh tab: chữ 15px SemiBold, vùng bấm rộng (Padding 14,8).
        Ba trạng thái — thường: chữ xám, nền trong suốt; rê chuột: nền xám tối bo góc, chữ sáng lên;
        đang chọn: nền TRÙNG khung chứa, viền trái/trên/phải trùng viền khung, KHÔNG có viền dưới (mở vào
        khung), chữ xanh và vạch xanh 3px ở MÉP TRÊN — vạch không thể nằm ở đáy vì đáy tab phải liền với khung.
        Mọi trạng thái đều giữ viền dày 1px (trong suốt khi không chọn) nên chọn tab không làm chữ nhảy.
        Trigger "đang chọn" đứng SAU trigger rê chuột nên thắng khi cả hai cùng đúng. Không có animation hay Effect.
    -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,6,0" SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8,8,0,0"
                                BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" Margin="0,3,0,1"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True">
                                <!--
                                    BẮT BUỘC. Tiêu đề là chuỗi nên WPF tự dựng một TextBlock, và style TextBlock
                                    chung của theme (màu TextPrimary, cỡ 13) đặt thẳng lên nó — ghi đè màu và cỡ
                                    chữ kế thừa từ TabItem. Thiếu đoạn này, mọi tab luôn chữ trắng cỡ 13 bất kể
                                    trạng thái. Lấy lại đúng hai giá trị đó từ TabItem.
                                -->
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <Setter Property="FontSize"
                                                Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <!-- Vạch xanh ở mép trên, thụt vào khỏi hai góc bo. -->
                        <Border x:Name="AccentBar" Height="3" VerticalAlignment="Top" Margin="10,1,10,0"
                                CornerRadius="0,0,2,2" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource TabHoverBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource TabHoverBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource TabContentBg}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TabContentBorder}"/>
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBright}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ScrollBar ================= -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource LG.Gray.Dark1Brush}" CornerRadius="3" Margin="3,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Nền trong suốt thay vì null: khoảng trống giữa các ô trong vùng cuộn mới "bắt" được con trỏ,
        nên rê chuột vào đâu trong vùng cũng lăn được. Nền null thì con trỏ xuyên qua, trúng Card
        phía sau (nằm ngoài ScrollViewer) và cú lăn không đi tới đâu. Xem WheelScrollAssist.
    -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SliderRepeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SliderRepeat}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="Width" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Expander (nhóm cài đặt thu gọn được) ================= -->
    <!--
        Nhóm cài đặt phẳng: nền tối hơn thẻ chứa một bậc, viền mảnh, không đổ bóng.

        Chấm tròn bên phải tiêu đề phản ánh Tag của Expander: xanh khi Tag = true (nhóm đang
        bật), xám khi false. Nhờ vậy thu gọn nhóm lại vẫn thấy ngay nhánh ngoài có đang hiện hay
        không, khỏi phải mở ra xem.
    -->
    <SolidColorBrush x:Key="ExpanderHoverBg" Color="#0FFFFFFF"/>

    <Style x:Key="SettingsExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource PanelBg}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBg" Background="Transparent" Padding="12,10"
                                                CornerRadius="{StaticResource RadiusCard}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBg" Property="Background"
                                                        Value="{StaticResource ExpanderHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="Chevron" Width="8" Height="8" Margin="0,0,10,0"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                          Data="M 2,0 L 6,4 L 2,8" Stretch="None"
                                          Stroke="{StaticResource TextDim}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource TextPrimary}"/>

                                    <Ellipse x:Name="StateDot" Grid.Column="2" Width="7" Height="7"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource TextMuted}"/>
                                </Grid>
                            </ToggleButton>

                            <Border x:Name="ContentHost" Visibility="Collapsed"
                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                                    Padding="14,6,14,12">
                                <ContentPresenter/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- DataTrigger chứ không phải Trigger: Tag kiểu object, Trigger sẽ so chuỗi
                             "True" với bool true và không bao giờ khớp. DataTrigger đổi kiểu trước khi so. -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource AccentBright}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ContextMenu (menu khay hệ thống) ================= -->
    <!--
        Template mặc định của Windows vẽ một CỘT ICON sáng màu chạy dọc mép trái mỗi mục —
        đó là vệt trắng thừa nhìn thấy trên menu khay. Gán Background cho ContextMenu không
        xoá được nó, vì cột đó nằm trong template của từng MenuItem. Cách duy nhất là thay
        cả hai template.
    -->
    <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="4,5"
                            Background="{StaticResource BorderBrushSoft}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" BasedOn="{StaticResource MenuSeparatorStyle}"/>

    <!--
        Bên trong Menu/ContextMenu, WPF KHÔNG dùng style ngầm của Separator mà tra cứu theo
        khoá MenuItem.SeparatorStyleKey. Thiếu dòng này thì dấu ngăn cách vẫn giữ template
        mặc định của Windows: một vạch sáng màu lạc lõng giữa nền Dark Slate.
    -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource MenuSeparatorStyle}"/>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent" Margin="0,1"
                            CornerRadius="{StaticResource RadiusInput}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chữ sát mép trái, chỉ cách đúng phần Padding. -->
                            <ContentPresenter Grid.Column="0" ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>

                            <!--
                                Dấu tích của mục bật/tắt nằm BÊN PHẢI. Đặt bên trái sẽ lại phải
                                chừa ra đúng cái cột icon vừa bỏ đi.
                            -->
                            <Path x:Name="CheckGlyph" Grid.Column="1" Visibility="Collapsed"
                                  Margin="18,0,0,0" VerticalAlignment="Center"
                                  Data="M 0,4.5 L 3.5,8 L 9,0.5"
                                  Stroke="{StaticResource AccentBright}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2600ED64"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource CardBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}"
                            Padding="5"
                            SnapsToDevicePixels="True">
                        <!--
                            StackPanel làm vật chứa thay cho Grid có cột gutter trong template
                            gốc; không còn chỗ nào dành riêng cho icon nữa.
                        -->
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Chú thích (hint) & ToolTip ================= -->
    <!--
        Dòng chú thích nhỏ: chữ xám phụ, tự xuống dòng, không kèm icon. Dùng như
        <ContentControl Style="{StaticResource Hint}" Content="..."/>. Chỉ để đọc: không nhận
        focus, không lọt vào vòng Tab.
    -->
    <Style x:Key="Hint" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- Nền trong suốt để rê chuột vào khoảng trống giữa các chữ vẫn hiện ToolTip. -->
                    <Border Background="Transparent">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ToolTip nền tối thay cho ToolTip trắng mặc định của Windows, vốn lệch hẳn với giao diện.
        Không dùng hiệu ứng đổ bóng (Effect), chỉ viền mảnh để tách khỏi nền.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusInput}"
                            Padding="10,6" MaxWidth="340" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <!-- Nội dung dạng chuỗi dài phải tự xuống dòng trong MaxWidth. -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="LineHeight" Value="17"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Card / Dialog ================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Nút hành động chính cỡ lớn, kéo hết chiều ngang cột (vd "Tạo mới" trên đầu danh sách preset). -->
    <Style x:Key="PrimaryWideButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Khung phụ lồng bên trong một Card, nền tối hơn để tách lớp. -->
    <Style x:Key="InnerCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

</ResourceDictionary>
