<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Menu chuột phải của icon khay. DataContext là TrayMenuViewModel, gán lúc tạo icon.

        Nút bật/tắt mang nhãn cố định "Overlay"; trạng thái nằm ở dấu tích — có dấu tích là overlay
        đang hiện. Giao diện (nền tối, không có cột icon, dấu tích xanh) đến từ Style
        ContextMenu/MenuItem trong Theme.xaml.

        x:Shared="False": mỗi lần lấy ra là một menu mới, không dùng chung một instance.
    -->
    <ContextMenu x:Key="TrayContextMenu" x:Shared="False">
        <MenuItem Header="{Binding OpenSettingsText, Mode=OneWay}" Command="{Binding OpenSettingsCommand}"/>
        <!--
            Dấu tích = overlay ĐANG HIỆN (trạng thái thật).

            IsChecked bind MỘT CHIỀU và KHÔNG bật IsCheckable: IsCheckable khiến WPF tự đảo dấu tích
            ngay lúc bấm, trước khi biết overlay có thật sự đổi hay không (vd game profile đang ép
            ẩn). Dấu tích chỉ được đổi khi trạng thái thật đổi.
        -->
        <MenuItem Header="{Binding OverlayText, Mode=OneWay}" Command="{Binding ToggleOverlayCommand}"
                  IsChecked="{Binding IsOverlayEnabled, Mode=OneWay}"/>
        <MenuItem Header="{Binding FavoritesText, Mode=OneWay}"
                  ItemsSource="{Binding FavoritePresets, Mode=OneWay}"
                  IsEnabled="{Binding HasFavorites, Mode=OneWay}">
            <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding Name, Mode=OneWay}"/>
                    <Setter Property="Command" Value="{Binding ApplyCommand, Mode=OneWay}"/>
                </Style>
            </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator/>
        <MenuItem Header="{Binding ExitText, Mode=OneWay}" Command="{Binding ExitCommand}"/>
    </ContextMenu>

</ResourceDictionary>
