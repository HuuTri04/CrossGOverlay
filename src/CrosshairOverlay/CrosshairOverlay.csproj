<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CrosshairOverlay</RootNamespace>
    <AssemblyName>CrossGOverlay</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Icon gắn vào chính file .exe: đây là thứ Explorer và Alt-Tab hiển thị. -->
    <ApplicationIcon>images\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Tiếng Việt là ngôn ngữ gốc, nhúng thẳng vào assembly chính; tiếng Anh nằm ở
         satellite assembly en\. Khai báo để ResourceManager khỏi đi tìm satellite "vi". -->
    <NeutralResourcesLanguage>vi</NeutralResourcesLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Một chỗ duy nhất cho số phiên bản: build\publish.ps1 đặt tên file .zip theo nó, tính năng tự cập nhật so
      sánh với thẻ phát hành trên GitHub, và huy hiệu phiên bản trên giao diện đọc từ assembly (Core.AppInfo).
      THẺ PHÁT HÀNH PHẢI KHỚP: gắn thẻ v1.0.1 mà gói vẫn là build 1.0.0 thì người dùng cập nhật xong vẫn ở
      bản cũ và bị mời cập nhật lại mãi.
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!--
      GC kiểu workstation + background. Overlay chạy nền suốt phiên chơi và chỉ cấp phát khi
      người dùng đổi preset, nên ưu tiên ĐỘ TRỄ thấp hơn thông lượng: một đợt thu gom gen2
      gây khựng sẽ thành micro-stutter nhìn thấy được trong game.
      ServerGC sẽ tạo một heap + luồng cho MỖI nhân CPU — hoàn toàn sai cho ứng dụng desktop.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

  <!--
    Cấu hình publish: MỘT THƯ MỤC chạy được trên máy CHƯA cài .NET Runtime. Phát hành bằng cách nén
    cả thư mục thành .zip (build\publish.ps1); tính năng tự cập nhật cũng tải đúng file .zip đó.
    Nhờ khai báo ở đây, `dotnet publish -c Release` không cần thêm tham số nào.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!--
      KHÔNG gộp thành một file .exe. Đo trên bản publish, cùng mã nguồn, dựng sạch từng biến thể,
      chạy xen kẽ nhiều vòng (mốc "khung hình đầu tiên" của cửa sổ, tính từ lúc tiến trình khởi động):

        một file, có nén (cấu hình cũ) : 1407–1921 ms — .NET nạp xong sau ~960 ms   — 69 MB, 1 file
        một file, không nén             : 1613–2052 ms — ~1100 ms                     — 159 MB, 1 file
        một file + DLL native để rời    : 1417–1824 ms — ~950 ms                      — 73 MB, 6 file
        thư mục                          :  642–1158 ms (phần lớn ~650) — ~175 ms      — 149 MB, 255 file

      Gói một file tốn ~800 ms ở MỖI lần mở, trước khi dòng mã đầu tiên của ứng dụng chạy — chi phí
      nằm ở chính gói bundle, không phải ở nén hay ở DLL native. Với một overlay chơi game, mở nhanh
      gấp đôi đáng giá hơn việc gọn trong một file.
    -->
    <PublishSingleFile>false</PublishSingleFile>

    <!--
      Biên dịch sẵn sang mã máy (ReadyToRun) để không phải JIT lúc khởi động.
      Đo thực tế trên dự án này, 9 lần chạy nóng xen kẽ, lấy trung vị:
        không R2R : 1992 ms, file 64.2 MB
        có R2R    : 1873 ms, file 68.8 MB
      Tức nhanh hơn khoảng 6% đổi lấy 4.6 MB. Khiêm tốn — phần lớn thời gian khởi động là
      nạp bundle và dựng cây WPF chứ không phải JIT — nhưng vẫn là cải thiện thật.

      Đã thử thêm PublishReadyToRunComposite (biên dịch chung .NET + ứng dụng thành một khối):
      khung hình đầu 640–1121 ms so với 642–1158 ms bản thường — không nhanh hơn, nặng thêm 85 MB.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!--
      PublishTrimmed CỐ TÌNH không bật.

      Không phải vì quên, cũng không phải vì chưa thử: SDK chặn cứng với lỗi
      "NETSDK1168: WPF is not supported or recommended with trimming enabled".
      Lý do kỹ thuật là WPF tra cứu kiểu lúc chạy khi phân giải XAML/BAML, binding và
      ControlTemplate, nên trimmer không nhìn ra kiểu nào thực sự được dùng. Cắt nhầm không gây
      lỗi biên dịch — nó nổ lúc chạy ở đúng bản publish mà người dùng tải về.

      Có cửa hậu `<_SuppressWpfTrimError>true</_SuppressWpfTrimError>` (dấu gạch dưới nghĩa là
      nội bộ, không được hỗ trợ) để ép qua. KHÔNG dùng: đánh đổi vài chục MB lấy nguy cơ app
      sập khi mở một tab bất kỳ, mà chỉ phát hiện được sau khi đã phát hành.

      Muốn giảm dung lượng thêm thì hướng đi đúng là bỏ bớt dependency, không phải trimming.
    -->

    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cho phép dự án test chạm vào các kiểu internal (AppJson, RenderPlan…). -->
    <InternalsVisibleTo Include="CrosshairOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build action Resource nhúng thẳng vào assembly, nên truy cập được qua
      pack://application:,,,/images/... bất kể người dùng chép thư mục đi đâu.
      Dùng Content thì file nằm rời cạnh .exe và chỉ cần sót một file là thiếu icon.
    -->
    <Resource Include="images\app.ico" />
    <Resource Include="images\BrandingLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Thư viện mẫu tâm ngắm (500+ mẫu, ~150 KB), sinh bởi tools/preset-catalog/scrape_and_convert.py.
      Content + PreserveNewest (Copy if newer): nằm rời cạnh .exe trong Data\ và theo vào bản publish. KHÔNG nhúng
      làm Resource: file chỉ được đọc khi người dùng mở cửa sổ Thư viện, không có lý do gì để nó nằm trong
      assembly nạp lúc khởi động.
    -->
    <Content Include="Data\builtin_presets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM: ObservableObject / [ObservableProperty] / [RelayCommand] source generators -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Dependency Injection + Logging abstractions -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />

    <!-- Logging sink: rolling file under %LOCALAPPDATA%\CrosshairOverlay\logs -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- System tray icon (WPF-native, no WinForms dependency) -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />

    <!-- Dựng icon khay hệ thống bằng GDI+. Vốn đã là dependency bắc cầu của H.NotifyIcon,
         khai báo tường minh vì ta dùng trực tiếp. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

</Project>
