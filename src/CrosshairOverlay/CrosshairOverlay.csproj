<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CrosshairOverlay</RootNamespace>
    <AssemblyName>CrossGOverlay</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Icon gắn vào chính file .exe: đây là thứ Explorer và Alt-Tab hiển thị. -->
    <ApplicationIcon>images\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Tiếng Việt là ngôn ngữ gốc, nhúng thẳng vào assembly chính; tiếng Anh nằm ở
         satellite assembly en\. Khai báo để ResourceManager khỏi đi tìm satellite "vi". -->
    <NeutralResourcesLanguage>vi</NeutralResourcesLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.1.0</Version>

    <!--
      GC kiểu workstation + background. Overlay chạy nền suốt phiên chơi và chỉ cấp phát khi
      người dùng đổi preset, nên ưu tiên ĐỘ TRỄ thấp hơn thông lượng: một đợt thu gom gen2
      gây khựng sẽ thành micro-stutter nhìn thấy được trong game.
      ServerGC sẽ tạo một heap + luồng cho MỖI nhân CPU — hoàn toàn sai cho ứng dụng desktop.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

  <!--
    Cấu hình publish: MỘT file .exe duy nhất, chạy được trên máy CHƯA cài .NET Runtime.
    Nhờ khai báo ở đây, `dotnet publish -c Release` không cần thêm tham số nào.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- WPF kéo theo nhiều DLL native; không bật cờ này thì chúng nằm rời cạnh file exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cho phép dự án test chạm vào các kiểu internal (AppJson, RenderPlan…). -->
    <InternalsVisibleTo Include="CrosshairOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build action Resource nhúng thẳng vào assembly, nên truy cập được qua
      pack://application:,,,/images/... và KHÔNG mất khi publish một file.
      Dùng Content thì file nằm rời cạnh .exe và bản portable sẽ thiếu icon.
    -->
    <Resource Include="images\app.ico" />
    <Resource Include="images\BrandingLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM: ObservableObject / [ObservableProperty] / [RelayCommand] source generators -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Dependency Injection + Logging abstractions -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />

    <!-- Logging sink: rolling file under %LOCALAPPDATA%\CrosshairOverlay\logs -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- System tray icon (WPF-native, no WinForms dependency) -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />

    <!-- Dựng icon khay hệ thống bằng GDI+. Vốn đã là dependency bắc cầu của H.NotifyIcon,
         khai báo tường minh vì ta dùng trực tiếp. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

</Project>
