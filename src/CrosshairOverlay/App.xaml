<Application x:Class="CrosshairOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CrosshairOverlay.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
                <ResourceDictionary Source="Resources/TrayMenu.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:ColorToBrushConverter x:Key="ColorToBrush"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:NotNullToBoolConverter x:Key="NotNullToBool"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
            <conv:RoundedNumberConverter x:Key="RoundedNumber"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
